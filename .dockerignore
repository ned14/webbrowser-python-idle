# Build context is the repo root (server/Dockerfile uses context `.` so it can
# COPY webvm/build and webvm/custom-disk-images). Keep the context small.
.git
.gitignore
.env
.env.example
certs
data
plans
prompts
scripts
tests
Makefile
README.md
compose.yaml
diskimage
gateway
webvm/.git
webvm/node_modules
webvm/.svelte-kit
webvm/assets/*.gif
