# Headscale configuration (pinned binary is headscale/headscale:0.29.3 — the
# Dockerfile explains why the pin moved from 0.28.0 to 0.29.3.
# Rendered by entrypoint.sh via envsubst with an explicit variable list).
#
# LAN-only control plane:
#   - server_url derives every client-facing URL (control + embedded DERP)
#   - NOTE: server_url is PATH-LESS. Verified: the tailscale client posts
#     /machine/register over the Noise channel using the server_url PATH
#     verbatim, and headscale's noise-internal router serves /machine/register
#     at the ROOT — so a `/headscale` base path 404s the registration. nginx
#     therefore proxies ALL of :CONTROL_PORT to headscale.
#   - embedded DERP enabled (region 999), public DERP disabled (urls: [])
#   - MagicDNS off (the guest uses IP addresses only)
#   - no exit node, disable check-updates (the server stays off the network)
#   - TLS terminated by nginx (this listener is plain HTTP on 127.0.0.1)
#   - logtail.enabled: false (netmap carries Debug.DisableLogTail -> clients
#     self-disable browser-side Tailscale logging; the page CSP also blocks
#     the logtail endpoint as belt-and-braces)
#
# Keys verified against the 0.29.3 binary's config schema (config-example.yaml
# @ tag v0.29.3): the ephemeral-node reaping key is NESTED
# `node.ephemeral.inactivity_timeout` in 0.29.x (the top-level
# `ephemeral_node_inactivity_timeout` was the 0.28.0 spelling and would be
# silently ignored by the 0.29.x binary). Every other key used below
# (server_url, listen_addr, metrics_listen_addr, grpc_*, trusted_proxies,
# noise.private_key_path, prefixes.*, derp.server.*, derp.urls,
# auto_update_enabled, update_frequency, disable_check_updates,
# database.*, log.*, policy.*, dns.*, unix_socket*, logtail.enabled,
# taildrop.enabled, auto_update.enabled) exists unchanged in the 0.29.3
# example file.

server_url: "https://${CONTROL_HOST}:${CONTROL_PORT}"
listen_addr: "127.0.0.1:8080"

# Disable the metrics listener (LAN-only control plane)
metrics_listen_addr: ""

grpc_listen_addr: "127.0.0.1:50443"
grpc_allow_insecure: false

# nginx is the only reverse proxy (loopback)
trusted_proxies:
  - "127.0.0.1/32"

noise:
  private_key_path: "/var/lib/headscale/noise_private.key"

prefixes:
  v4: "100.64.0.0/10"
  v6: "fd7a:115c:a1e0::/48"
  allocation: sequential

derp:
  server:
    # Embedded DERP relay — mandatory for the LAN-only setup.
    enabled: true
    region_id: 999
    region_code: "webvm"
    region_name: "WebVM LAN"
    # Only known nodes may relay (desired for LAN confinement)
    verify_clients: true
    # STUN listener is mandatory for the embedded DERP.
    stun_listen_addr: "0.0.0.0:${STUN_PORT}"
    private_key_path: "/var/lib/headscale/derp_server_private.key"
    automatically_add_embedded_derp_region: true
    # MUST NOT be the config-example TEST-NET placeholders, which headscale
    # advertises verbatim in the DERP map. Empty = not advertised.
    ipv4: ""
    ipv6: ""
  # No public Tailscale DERP regions
  urls: []
  auto_update_enabled: false
  update_frequency: "24h"

# The server itself never checks for updates
disable_check_updates: true

# Time before an inactive ephemeral node is deleted (NESTED key, 0.29.x
# spelling — the top-level `ephemeral_node_inactivity_timeout` was 0.28.0 and
# is ignored by the pinned binary). Browser VMs join with an ephemeral preauth
# key (HEADSCALE_PREAUTHKEY is created with --ephemeral), so closed tabs stop
# accumulating stale nodes after this window; the GATEWAY node is persistent
# (tailnet-IP stability) and is never reaped.
#
# Kept at 30m — NOT shortened: the pinned wasm client's netmap validation
# requires the netmap to contain more than a bare-minimum peer set (with
# only the gateway + one client node the client loops on "authReconfig:
# netmap not yet valid. Skipping." and never reaches Running — verified
# 2026-08-30; with ~7+ registered nodes the same client becomes valid and
# connects). The E2E suite's sequential boots naturally accumulate enough
# nodes within the 30m window; a shorter reaping window starved the netmap
# and broke the tailnet join (the network-spec regression when this was
# tried at 5m).
node:
  ephemeral:
    inactivity_timeout: "30m"

database:
  type: sqlite
  sqlite:
    path: "/var/lib/headscale/db.sqlite"
    write_ahead_log: true

log:
  level: info
  format: text

policy:
  mode: file
  path: ""

dns:
  magic_dns: false
  base_domain: "example.com"
  override_local_dns: false
  nameservers:
    global: []
    split: {}
  search_domains: []
  extra_records: []

unix_socket: "/var/run/headscale/headscale.sock"
unix_socket_permission: "0770"

# Browser-side Tailscale logging: keep disabled (the page also CSP-blocks the
# logtail endpoint as belt-and-braces).
logtail:
  enabled: false

taildrop:
  enabled: true

auto_update:
  enabled: false
