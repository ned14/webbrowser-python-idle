# nginx configuration (rendered at container start by entrypoint.sh via
# envsubst with an EXPLICIT variable list — never bare envsubst, which would
# mangle $ in credentials).
#
# Two HTTPS listeners, both binding 0.0.0.0 inside the container:
#   SITE_PORT (8081)    the WebVM site (COOP/COEP/CORP, CSP connect-src)
#   CONTROL_PORT (8443) Headscale control + embedded DERP (WSS)
# Exposure to the host is restricted by compose port bindings (LAN_IP only).

# brotli_static module (Alpine subpackage nginx-mod-http-brotli, version-matched
# to the installed nginx by apk): serves pre-generated .br siblings produced by
# scripts/precompress-static.sh at frontend build time.
load_module /usr/lib/nginx/modules/ngx_http_brotli_static_module.so;

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
	worker_connections 1024;
}

http {
	include /etc/nginx/mime.types;
	default_type application/octet-stream;
	sendfile on;
	keepalive_timeout 120s;

	# Compress the (large) JS/WASM runtime and app chunks; the ext2 is exempt.
	gzip on;
	gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
	gzip_min_length 1024;

	# Precompressed statics: serve the .br siblings generated once at
	# frontend build time (scripts/precompress-static.sh) instead of
	# compressing per request. This removes per-response CPU (the 31 MB
	# tailscale.wasm is by far the heaviest) and keeps the strongest setting
	# (brotli q11) without latency. Deliberately NO `gzip_static on` here:
	# both modules register PRECONTENT-phase handlers and the built-in
	# gzip_static runs first, so with .gz siblings present it would shadow
	# brotli_static for every gzip-capable client (i.e. all browsers) and the
	# smaller br representation would never be served. Clients without br
	# support — and files shipped without a sibling, e.g. /webvm-config.js,
	# rendered at container start — fall through to runtime gzip below. The
	# ext2 location explicitly turns BOTH static filters off: byte-range
	# serving cannot use a compressed representation.
	brotli_static on;

	map $http_upgrade $connection_upgrade {
		default upgrade;
		''      close;
	}

	# ----------------------------------------------------------------------
	# Site (SITE_PORT)
	# ----------------------------------------------------------------------
	server {
		listen ${SITE_PORT} ssl;
		# HTTP/2 for the SITE listener: boot issues many small byte-range GETs
		# against the ext2 plus the runtime assets, which HTTP/1.1 serializes
		# across at most ~6 connections per origin — h2 multiplexes them over
		# one TLS connection. Directive form (nginx >= 1.25.1; the image ships
		# 1.30.x). The CONTROL/WSS listeners stay deliberately h1-only: their
		# traffic is long-lived WebSocket upgrades (/ts2021, /derp), and nginx
		# has no RFC 8441 WS-over-h2 — offering ALPN h2 there buys nothing and
		# only adds a protocol branch to the control path.
		http2 on;
		server_name _;

		ssl_certificate     /certs/server.crt;
		ssl_certificate_key /certs/server.key;

		# Cross-origin isolation — mandatory for CheerpX (SharedArrayBuffer
		# requires a secure context; HTTPS is the only access mode).
		add_header Cross-Origin-Opener-Policy "same-origin" always;
		add_header Cross-Origin-Embedder-Policy "require-corp" always;
		add_header Cross-Origin-Resource-Policy "cross-origin" always;

		# The only connect-src host list: self + the control plane. This blocks
		# the compiled-in Tailscale logtail fetch (and any other third-party
		# request) — the page and WASM client make ZERO external requests.
		# script-src 'self' covers the self-hosted CheerpX runtime modules/workers
		# (/cheerpx/*) and the app bundle.
		# The portless https/wss entries cover the wasm client's DEFAULT-PORT
		# URLs: the bundled client drops the controlUrl port when it builds the
		# Noise-over-WebSocket URL (wss://<host>/ts2021) and the DERP URLs, so
		# the scheme-default 443 (CONTROL_WSS_PORT, relayed by the gateway in
		# tailnet modes) must be allowed too. Scoped to :443 explicitly — never
		# portless, which would open the WHOLE host to connect-src.
		add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://${CONTROL_HOST}:${CONTROL_PORT} wss://${CONTROL_HOST}:${CONTROL_PORT} https://${CONTROL_HOST}:443 wss://${CONTROL_HOST}:443" always;

		root /srv/webvm/build;

		# The stock Debian terminal route must never load (it fetches a public
		# disk image); always land on the Alpine desktop.
		location = / {
			return 302 /alpine.html;
		}
		location = /alpine {
			return 301 /alpine.html;
		}

		# Baked networking/sync config (entrypoint-rendered): the page seeds
		# sessionStorage from it when the URL hash carries nothing, so visiting
		# the site root auto-wires the tailnet. NEVER cached — it changes when
		# .env keys rotate and the container is recreated. (The add_header here
		# suppresses the server-level security headers on this same-origin
		# script; same-origin resources are exempt from COEP require-corp.)
		# CORP same-origin is REQUIRED: without it any webpage could load this
		# classic script cross-origin and read window.__webvmConfig (the
		# preauth key + sync credentials) — PNA does not cover private->private
		# (LAN) loads and Safari does not enforce PNA.
		location = /webvm-config.js {
			alias /etc/webvm/webvm-config.js;
			add_header Cache-Control "no-store";
			add_header Cross-Origin-Resource-Policy "same-origin";
		}

		# Guest ext2 image. Explicit absolute alias (never `root .`, which
		# resolves against the nginx prefix dir). Byte-range serving is native
		# to nginx; gzip is off for the image.
		location /custom-disk-images/ {
			alias /srv/webvm/custom-disk-images/;
			# Byte-range serving requires the RAW body: disable the runtime
			# compressor AND the static-sibling filters (both inherit from
			# http{} scope) so a stray .br/.gz beside the ext2 can never
			# make nginx serve a compressed representation to HttpBytesDevice
			# range reads.
			gzip off;
			brotli_static off;
			gzip_static off;
		}

		# Self-hosted CheerpX runtime (versioned by the pinned 1.3.7 in
		# webvm/cheerpx) and the SvelteKit hashed chunks: immutable, cached
		# hard — the runtime is ~21 MB and must not be re-downloaded per load.
		# (The security add_headers are repeated here because a location that
		# defines its own add_header does NOT inherit the server-level ones.)
		location /cheerpx/ {
			add_header Cross-Origin-Opener-Policy "same-origin" always;
			add_header Cross-Origin-Embedder-Policy "require-corp" always;
			add_header Cross-Origin-Resource-Policy "cross-origin" always;
			add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://${CONTROL_HOST}:${CONTROL_PORT} wss://${CONTROL_HOST}:${CONTROL_PORT} https://${CONTROL_HOST}:443 wss://${CONTROL_HOST}:443" always;
			add_header Cache-Control "public, max-age=31536000, immutable";
			try_files $uri =404;
		}
		location /_app/immutable/ {
			add_header Cross-Origin-Opener-Policy "same-origin" always;
			add_header Cross-Origin-Embedder-Policy "require-corp" always;
			add_header Cross-Origin-Resource-Policy "cross-origin" always;
			add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://${CONTROL_HOST}:${CONTROL_PORT} wss://${CONTROL_HOST}:${CONTROL_PORT} https://${CONTROL_HOST}:443 wss://${CONTROL_HOST}:443" always;
			add_header Cache-Control "public, max-age=31536000, immutable";
		}

		location / {
			try_files $uri $uri/ =404;
		}
	}

	# ----------------------------------------------------------------------
	# Control plane + embedded DERP (CONTROL_PORT)
	# ----------------------------------------------------------------------
	server {
		listen ${CONTROL_PORT} ssl;
		server_name _;

		ssl_certificate     /certs/server.crt;
		ssl_certificate_key /certs/server.key;

		# COEP require-corp compatibility for the /derp/probe latency probe
		# (issued in CORS mode by the pinned wasm client; belt-and-braces).
		add_header Cross-Origin-Resource-Policy "cross-origin" always;

		# CORS for the browser-side Tailscale client (CheerpX wasm): it fetches
		# the control-plane /key endpoint cross-origin (page origin on
		# SITE_PORT -> control plane on CONTROL_PORT), and headscale only
		# answers /derp/probe with Access-Control-Allow-Origin — every other
		# control-plane response lacks it, so the fetch is blocked and the
		# guest tailnet never starts. Echo the request Origin (the browser
		# fetch is non-credentialed; a LAN-only personal control plane) with
		# Vary: Origin for correct caching. WebSockets (/ts2021, /derp) are
		# not subject to CORS, but the header is harmless on them too.
		#
		# NB the echo is CONDITIONAL on a non-empty Origin: headscale already
		# answers /derp/probe with ACAO: * and the wasm client's DERP probe
		# (HEAD, no Origin header) must NOT receive an empty
		# "Access-Control-Allow-Origin: " alongside it — a second invalid ACAO
		# value makes the browser reject the probe (net::ERR_FAILED) and the
		# client never finishes its DERP selection.
		# Catch-all reverse proxy to headscale (its v0.29.x control protocol is
		# PATH-LESS: /key, /ts2021 (Noise upgrade), /derp, /bootstrap-dns and
		# the legacy /machine/register are all served at the root — the
		# server_url carries no path. The embedded-DERP relay URL headscale
		# derives is https://${CONTROL_HOST}:${CONTROL_PORT}/derp, which the
		# bare /derp path here must match (a trailing-slash location alone
		# would not).
		#
		# All locations need the same WebSocket handling as /headscale/
		# (headscale's DERP handler answers 426 Upgrade Required and its
		# TS2021 handler answers 500 to any non-upgraded request).
		location / {
			# Echo the request Origin ONLY when present, and HIDE headscale's
			# own ACAO (it answers /derp/probe with ACAO: *): two
			# Access-Control-Allow-Origin values ("*" + the echoed origin)
			# make the browser reject the wasm client's DERP probe with
			# net::ERR_FAILED (MultipleAllowOriginValues) and the client never
			# finishes its DERP selection.
			proxy_hide_header Access-Control-Allow-Origin;
			if ($http_origin) {
				add_header Access-Control-Allow-Origin $http_origin always;
				add_header Vary Origin always;
			}
			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection $connection_upgrade;
			proxy_set_header Host $host;
			proxy_set_header True-Client-IP $remote_addr;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
			proxy_buffering off;
			proxy_read_timeout 3600s;
			proxy_send_timeout 3600s;
			proxy_pass http://127.0.0.1:8080;
		}
	}

	# ----------------------------------------------------------------------
	# Control plane on the DEFAULT WSS port (CONTROL_WSS_PORT, default 443).
	# The bundled CheerpX wasm client builds its Noise-over-WebSocket URL as
	# wss://<control-host>/ts2021 (the controlUrl PORT IS DROPPED — Leaning's
	# fork always uses the scheme-default port), so the control plane must
	# also be reachable on 443. Same config as the CONTROL_PORT listener.
	# ----------------------------------------------------------------------
	server {
		listen ${CONTROL_WSS_PORT} ssl;
		server_name _;

		ssl_certificate     /certs/server.crt;
		ssl_certificate_key /certs/server.key;

		add_header Cross-Origin-Resource-Policy "cross-origin" always;

		location / {
			# Echo the request Origin ONLY when present, and HIDE headscale's
			# own ACAO (it answers /derp/probe with ACAO: *): two
			# Access-Control-Allow-Origin values ("*" + the echoed origin)
			# make the browser reject the wasm client's DERP probe with
			# net::ERR_FAILED (MultipleAllowOriginValues) and the client never
			# finishes its DERP selection.
			proxy_hide_header Access-Control-Allow-Origin;
			if ($http_origin) {
				add_header Access-Control-Allow-Origin $http_origin always;
				add_header Vary Origin always;
			}
			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection $connection_upgrade;
			proxy_set_header Host $host;
			proxy_set_header True-Client-IP $remote_addr;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
			proxy_buffering off;
			proxy_read_timeout 3600s;
			proxy_send_timeout 3600s;
			proxy_pass http://127.0.0.1:8080;
		}
	}
}
