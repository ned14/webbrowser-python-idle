# i3 config for the WebVM personal desktop.
# The autostart runs the file explorer (a stdlib-only Tk app,
# /usr/local/bin/file-explorer.py) on the user's home directory; a keep-alive
# daemon (/usr/local/bin/keep-file-explorer.sh) relaunches it whenever the last
# window closes, so the desktop never sits empty. IDLE is launched on demand
# from it ("Open with IDLE" / double-click a .py) and REPLACES the explorer on
# screen for the duration: the explorer withdraws itself, waits for IDLE to
# exit, then reappears with a refreshed listing. $mod+Return opens xterm;
# $mod+Shift+f reopens the file explorer.

set $mod Mod4

font pango:DejaVu Sans Mono 10

# Autostart the file explorer on the user's home directory (the desktop
# client). The launcher guards against a second instance (the keep-alive uses
# the same one).
exec --no-startup-id /usr/local/bin/open-file-explorer.sh

# Keep-alive: relaunch the file explorer whenever the last window closes, so
# the desktop never ends up empty (see /usr/local/bin/keep-file-explorer.sh).
exec --no-startup-id /usr/local/bin/keep-file-explorer.sh

# Start a terminal
bindsym $mod+Return exec xterm

# Start the file explorer (no-op when one is already running, e.g. withdrawn
# behind IDLE)
bindsym $mod+Shift+f exec /usr/local/bin/open-file-explorer.sh

# Kill focused window
bindsym $mod+Shift+q kill

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Layout
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

# Workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4

# Reload / restart / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-msg exit"

# Floating modifier
floating_modifier $mod

# Gaps-free, simple layout
default_border pixel 2
