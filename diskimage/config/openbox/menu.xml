<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal Openbox right-click root menu for the WebVM desktop. -->
<openbox_menu xmlns="http://openbox.org/3.5/menu">
  <menu id="root-menu" label="Openbox 3">
    <item label="Terminal (xterm)">
      <action name="Execute"><command>xterm</command></action>
    </item>
    <item label="File Explorer">
      <action name="Execute"><command>/usr/local/bin/open-file-explorer.sh</command></action>
    </item>
    <separator/>
    <item label="Close Window">
      <action name="Close"/>
    </item>
    <item label="Reconfigure Openbox">
      <action name="Reconfigure"/>
    </item>
    <item label="Restart Openbox">
      <action name="Restart"/>
    </item>
  </menu>
</openbox_menu>
