#!/bin/sh
# X startup as the 'user' account.
# The system /etc/X11/xinit/xinitrc EXECs ~/.xinitrc before it ever reaches
# /etc/X11/xinit/xinitrc.d, so the screen-resize hook is sourced here instead.
# Layout defaults to US; override with `setxkbmap <layout>`.

# Harmless GTK tweaks left over from the pcmanfm era; the current desktop apps
# (Tk file explorer, IDLE) do not use GTK, but keeping them costs nothing.
export NO_AT_BRIDGE=1
export GSETTINGS_BACKEND=memory

for f in /etc/X11/xinit/xinitrc.d/?*; do
	[ -x "$f" ] && . "$f"
done

setxkbmap us 2>/dev/null

xrdb -merge "$HOME/.Xresources" 2>/dev/null

# Solid black desktop root (Openbox paints no background itself; the X server's
# raw root weave would otherwise leave a light, non-black backdrop that breaks
# the "desktop went to black" swap detection in the E2E suite). Idempotent.
xsetroot -solid black 2>/dev/null

# Openbox runs through `openbox-session` under a per-session D-Bus: the session
# wrapper is what actually executes ~/.config/openbox/autostart (a bare
# `openbox` would not). It autostarts the file explorer + keep-alive daemon,
# maximizes each window to fill the canvas, and draws a ✕ Close button on
# every titlebar.
exec dbus-run-session -- openbox-session
