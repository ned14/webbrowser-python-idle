#!/bin/sh
# Boot the X desktop as the 'user' account (never as root — Xorg refuses root,
# and i3's autostarts must land in /home/user).
set -u

BACKEND=$(cat /etc/webvm-backend 2>/dev/null || echo browser)

# Bring eth0 up once the emulated NIC appears. The CheerpX NIC is only created
# after the browser-side Tailscale client connects, so configuration is
# retried here (open spike: baked /etc/network/interfaces + this retry loop).
(
	i=0
	while [ "$i" -lt 60 ]; do
		ip link show eth0 >/dev/null 2>&1 && break
		sleep 2
		i=$((i + 1))
	done
	for _j in 1 2 3 4 5; do
		ip link set eth0 up 2>/dev/null
		udhcpc -i eth0 -n >/dev/null 2>&1 && break
		sleep 5
	done
) &

# Sync boot-pull before the desktop starts (samba/webdav only; best-effort —
# waits for the tailnet up to ~90s, then returns regardless so a misconfigured
# tailnet cannot delay the desktop indefinitely). The push loop then runs as a
# single background process; it holds the backend lease (a second tab/session
# is refused).
case "$BACKEND" in
	samba|webdav)
		su user -c /usr/local/bin/sync-home.sh pull
		su user -c /usr/local/bin/sync-home.sh daemon &
		;;
esac

mkdir -p /run/user/1000
chown user:user /run/user/1000
chmod 700 /run/user/1000

# Generate the guest SSH keypair on first boot (never baked into the served
# image). Authorize the public key on any LAN git server to allow pushes.
if [ ! -f /home/user/.ssh/id_ed25519 ]; then
	su user -c 'ssh-keygen -q -t ed25519 -N "" -f /home/user/.ssh/id_ed25519'
fi

# X socket directory: Xorg runs as root here (see below); keep the socket dir
# world-writable so the user session can connect.
mkdir -p /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix

# Start the X server as ROOT, then the user session as 'user'.
#   * /usr/bin/Xorg is the Xorg.wrap security wrapper, which refuses to run
#     the real X server as a non-root, non-console user; the guest has no
#     console login session for `user`, so the server MUST be started as root
#     (exactly how display managers — LightDM in the reference image — do it).
#   * `startx` appends `vt<N> -keeptty` to the Xorg command line and Xorg's VT
#     ioctls hang in the VT-less CheerpX guest, so Xorg is launched directly
#     with VT switching disabled (the plan's sanctioned fallback).
#   * The session then runs as `user` via ~/.xinitrc (screen-resize hook,
#     setxkbmap, xrdb, i3 under a per-session D-Bus).
# The X server startup and the socket wait run in the FOREGROUND of
# desktop.start so their output (and any failure reason from /var/log/xorg.log)
# is visible on the boot console; the wait is BOUNDED (60s), so the boot
# always continues. Only the user session is backgrounded — OpenRC's `local`
# service completes while i3/IDLE keep running.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
# stderr is NOT redirected: Xorg's startup errors go to the boot console
# (xterm) as well as /var/log/xorg.log, so a failed start is visible in-page.
Xorg :0 -nolisten tcp -noreset -novtswitch -logfile /var/log/xorg.log </dev/null &
XPID=$!
i=0
while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 60 ]; do
	sleep 1
	i=$((i + 1))
done
if [ ! -S /tmp/.X11-unix/X0 ]; then
	echo "Xorg failed to start (tail of /var/log/xorg.log):" >/dev/console
	tail -n 25 /var/log/xorg.log >/dev/console 2>/dev/null || true
	kill "$XPID" 2>/dev/null
	exit 1
fi
# Surface the X server's startup on the console (the guest has no other way
# to report its details to the page).
tail -n 8 /var/log/xorg.log >/dev/console 2>/dev/null || true
# The session is backgrounded; its output is redirected to /dev/console so
# i3/dbus failures stay visible on the page's console (the boot log screen
# would otherwise hide them).
echo "launching the X desktop session as 'user'..." >/dev/console
su user -c "export XDG_RUNTIME_DIR=/run/user/1000; DISPLAY=:0 sh /home/user/.xinitrc" >/dev/console 2>&1 &
