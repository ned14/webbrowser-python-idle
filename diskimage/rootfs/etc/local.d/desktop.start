#!/bin/sh
# Boot the X desktop. The session runs as the 'user' account; the X SERVER
# itself runs as root (/usr/bin/Xorg here is the Xorg.wrap security wrapper,
# which refuses to launch the real server for a non-root, non-console user —
# see the launch block below).
set -u

BACKEND=$(cat /etc/webvm-backend 2>/dev/null || echo browser)

# Warm the font files into the page's block cache before any interactive Tk
# use. On the GitHub Pages deployment the disk image is streamed lazily as
# chunks; a font open that needs a COLD network read can transiently fail
# (Tk: "failed to allocate font due to internal system font engine problem"),
# so read the installed fonts up front (cheap; the blocks then come from the
# cached overlay for every later font use, desktop and guest scripts alike).
(cat /usr/share/fonts/dejavu/*.ttf /usr/share/fonts/misc/*.pcf.gz >/dev/null 2>&1) &

# Warm the Tk/Python read set (libpython3.14.so, the tcl/tk libs, the tcl
# encodings) the same way, BEFORE the X session launches the file explorer:
# the explorer's `import tkinter` does a burst of cold block reads at the
# exact moment an emulator-load deadlock has been observed (2026-09-01: the
# stall's last reads were the Tk/python blocks; plans/diagnose-flaky-boots.md).
# A background python startup costs ~2-4 s of emulated CPU while Xorg starts
# in parallel; the blocks then come from the guest FS cache for the explorer,
# IDLE and every later Tk app.
(python3 -c "import tkinter" >/dev/null 2>&1) &

# Bring eth0 up once the emulated NIC appears. The CheerpX NIC is only created
# after the browser-side Tailscale client connects, so configuration is
# retried here (open spike: baked /etc/network/interfaces + this retry loop).
(
	i=0
	while [ "$i" -lt 60 ]; do
		ip link show eth0 >/dev/null 2>&1 && break
		sleep 2
		i=$((i + 1))
	done
	# Only run DHCP when eth0 actually exists. When the NIC never appears
	# (CheerpX core defect — the guest device is never created even with the
	# browser-side client Running, see plans/networking-bug.md §15), udhcpc
	# still opens a raw socket on the missing interface, which crashes the
	# CheerpX core with `RuntimeError: function signature mismatch` (a wasm
	# call_indirect trap inside the core's socket dispatch) and takes the
	# whole VM down — deterministically ~120s after boot.
	if ip link show eth0 >/dev/null 2>&1; then
		for _j in 1 2 3 4 5; do
			ip link set eth0 up 2>/dev/null
			udhcpc -i eth0 -n >/dev/null 2>&1 && break
			sleep 5
		done
	fi
	# Decide IDLE's loopback mode ONCE per boot (idle3.14-launcher consults
	# this cached verdict instead of re-probing on every launch — the dead-
	# accept tailscale runtime made each probe burn ~2-8 s per IDLE open).
	/usr/local/bin/idle-loopback-cache >/dev/null 2>&1 || true
) &

# Sync boot-pull before the desktop starts (samba/webdav only; best-effort —
# waits for the tailnet up to ~75s, then returns regardless so a misconfigured
# tailnet cannot delay the desktop indefinitely). The push loop then runs as a
# single background process; it holds the backend lease (a second tab/session
# is refused).
case "$BACKEND" in
	samba|webdav)
		# One backgrounded root process runs the boot pull and then becomes
		# the push daemon (sync-home.sh both). CheerpX quirks worked around
		# here (verified 2026-08-15, plans/networking-bug.md §16):
		#   * a backgrounded `su user -c …` never executes its child, while
		#     a plain root background child works — so this runs as root
		#     (HOME set explicitly: root's Path.home() would be /root, not
		#     /home/user);
		#   * spawning a second process after the pull (daemon) never runs,
		#     and the pull's process teardown can wedge the guest — so pull
		#     and push loop share ONE process and never tear it down;
		#   * concurrent guest processes doing overlay FS work can wedge —
		#     one process avoids it;
		#   * python time.sleep() timers never fire — sync.py's critical
		#     path avoids sleeping (DEBOUNCE_S=0) and _sleep() is a
		#     best-effort socket-timeout wait for the non-critical loops.
		HOME=/home/user /usr/local/bin/sync-home.sh both </dev/null >/dev/null 2>&1 &
		;;
esac

mkdir -p /run/user/1000
chown user:user /run/user/1000
chmod 700 /run/user/1000

# Generate the guest SSH keypair on first boot (never baked into the served
# image). Authorize the public key on any LAN git server to allow pushes.
# BACKGROUNDED: it is not needed before the desktop maps, and under
# emulation the first-boot keygen costs ~0.1-0.5 s of the boot critical
# path for nothing.
if [ ! -f /home/user/.ssh/id_ed25519 ]; then
	(su user -c 'ssh-keygen -q -t ed25519 -N "" -f /home/user/.ssh/id_ed25519' >/dev/null 2>&1) &
fi

# X socket directory: Xorg runs as root here (see below); keep the socket dir
# world-writable so the user session can connect.
mkdir -p /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix

# Start the X server as ROOT, then the user session as 'user'.
#   * /usr/bin/Xorg is the Xorg.wrap security wrapper, which refuses to run
#     the real X server as a non-root, non-console user; the guest has no
#     console login session for `user`, so the server MUST be started as root
#     (exactly how display managers — LightDM in the reference image — do it).
#   * `startx` appends `vt<N> -keeptty` to the Xorg command line and Xorg's VT
#     ioctls hang in the VT-less CheerpX guest, so Xorg is launched directly
#     with VT switching disabled (the plan's sanctioned fallback).
#   * The session then runs as `user` via ~/.xinitrc (screen-resize hook,
#     setxkbmap, xrdb, openbox under a per-session D-Bus).
# The X server startup and the socket wait run in the FOREGROUND of
# desktop.start so their output (and any failure reason from /var/log/xorg.log)
# is visible on the boot console; the wait is BOUNDED (60s), so the boot
# always continues. Only the user session is backgrounded — OpenRC's `local`
# service completes while openbox/IDLE keep running.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
# stderr is NOT redirected: Xorg's startup errors go to the boot console
# (xterm) as well as /var/log/xorg.log, so a failed start is visible in-page.
Xorg :0 -nolisten tcp -noreset -novtswitch -logfile /var/log/xorg.log </dev/null &
XPID=$!
i=0
# 250 ms poll (was 1 s): Xorg startup is the boot's long pole and the wait
# is bounded (60 s), so a tighter poll shaves up to ~1 s off boot with no
# cost while X is still starting (the poll itself is a trivial stat).
while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 240 ]; do
	sleep 0.25
	i=$((i + 1))
done
if [ ! -S /tmp/.X11-unix/X0 ]; then
	echo "Xorg failed to start (tail of /var/log/xorg.log):" >/dev/console
	tail -n 25 /var/log/xorg.log >/dev/console 2>/dev/null || true
	kill "$XPID" 2>/dev/null
	exit 1
fi
# Surface the X server's startup on the console (the guest has no other way
# to report its details to the page).
tail -n 8 /var/log/xorg.log >/dev/console 2>/dev/null || true
# The session is backgrounded; its output is redirected to /dev/console so
# openbox/dbus failures stay visible on the page's console (the boot log screen
# would otherwise hide them).
echo "launching the X desktop session as 'user'..." >/dev/console
su user -c "export XDG_RUNTIME_DIR=/run/user/1000; DISPLAY=:0 sh /home/user/.xinitrc" >/dev/console 2>&1 &

# Paste typer (the SIMPLE paste lane): reads CXCLIP frames from the console
# tty (stdin = /dev/console — the page's console input channel) and types
# them into the X-input-focus window via xsendkeys (XTEST), printing CXACK/
# CXFAIL on the console. Runs as root; DISPLAY must be :0. See
# /usr/local/bin/paste-typer.sh for the CheerpX quirks it works around.
DISPLAY=:0 /usr/local/bin/paste-typer.sh </dev/console >/dev/console 2>&1 &
