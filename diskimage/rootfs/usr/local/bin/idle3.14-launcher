#!/bin/sh
# IDLE launch wrapper.
#
# PID file for the keep-alive daemon: while IDLE is up, the explorer keeps
# its window but stays inert (disabled UI), and the keep-alive must not treat
# that as a stuck desktop. pgrep -f is unusable in the guest (the CheerpX
# core traps on /proc/<pid>/cmdline reads of processes still being set up —
# see faccessat-fix.c), so liveness is tracked via this file. The pid is ours
# and stays ours across the exec below (idle3.14 -> python3), so it is
# exactly IDLE's pid. The "pid starttime" format (field 22 of
# /proc/self/stat) lets the shared guard (webvm-pidfile.sh) reject a
# RECYCLED pid — see file-explorer.py's pidfile for the full rationale.
_STARTTIME=$(awk '{print $22}' /proc/self/stat 2>/dev/null || echo "")
echo "$$ $_STARTTIME" > /tmp/idle.pid 2>/dev/null

# Subprocess mode (-n or not) is decided by the per-boot cached loopback
# probe (idle-loopback-cache; full rationale in its header): on tailnet
# runtimes with the dead accept path, re-probing here burned its select/
# accept timeouts on EVERY launch (~2-8 s of blank-screen swap). The verdict
# is computed once per boot — backgrounded at desktop.start, with this
# launcher as the inline fallback for an undecided boot — and cached.
if /usr/local/bin/idle-loopback-cache; then
	exec idle3.14 "$@"
fi
# Loopback TCP unusable (no networking, an unregistered/unreachable tailnet,
# or the runtime's dead accept path): run IDLE in-process (-n).
exec idle3.14 -n "$@"
