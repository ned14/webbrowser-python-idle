# WebVM custom deployment overrides.
# This file is optional: everything has an inline default in compose.yaml.
# Copy to `.env` and edit. NEVER commit `.env`.

# --- Access / networking ---
# Single machine: keep the defaults — CONTROL_HOST=127.0.0.1 (zero-config,
# NO /etc/hosts entries, NO hostnames of any kind). LAN/multi-device use:
# set both CONTROL_HOST and LAN_IP to the hardcoded LAN address, e.g.
# 192.168.1.10. HOSTNAMES ARE BANNED (host.docker.internal and /etc/hosts
# tricks must never be reintroduced): the browser reaches the control plane
# over 127.0.0.1 / a LAN IP alone.
# Ports are published ONLY on LAN_IP — never on all interfaces.
CONTROL_HOST=127.0.0.1
LAN_IP=127.0.0.1

# Ports (defaults; arbitrary remapping supported — see the plan §10.9)
SITE_PORT=8081
CONTROL_PORT=8443
WEBDAV_PORT=8082
STUN_PORT=3478
# The WebDAV URL base path (single home: scripts/lib/webvm-common.sh — the
# wsgidav mount, the baked syncUrl and the guest syncrc default all render
# from it).
WEBDAV_BASE_PATH=/webdav/
# The server container's static compose-network IP — the gateway/join-test
# client reach the control plane at this address (cert SAN covers it; the
# cert generator, compose and the gateway must agree — the shared default
# lives in scripts/lib/webvm-common.sh).
GATEWAY_CONTROL_IP=172.28.0.10

# --- Storage backend (browser | samba | webdav | none) ---
STORAGE_BACKEND=browser

# Optional cross-origin base for the ext2 disk-image URL (OPTIONAL, opt-in):
# empty = the page reads the ext2 same-origin. Set it (e.g.
# https://disk.webvm.nedprod.com — a DNS record pointing at THIS box, with
# the CDN proxy turned OFF for that record) to serve the image from a
# dedicated disk host. The value flows to the frontend bake, the CSP
# connect-src, the nginx CORS answer AND the server-cert SAN (private CA and
# Let's Encrypt alike).
WEBVM_DISK_BASE_URL=

# --- Let's Encrypt public cert (OPTIONAL, opt-in) ---
# By default the server cert is signed by certs/ca.crt (the private CA you
# trust once per browser — required for 127.0.0.1/LAN access). Public
# deployments whose browsers must trust the origin WITHOUT installing that CA
# (e.g. a proxied-off disk host like the WEBVM_DISK_BASE_URL above, read by
# every visitor) can instead serve a PUBLIC Let's Encrypt cert:
#   LETSENCRYPT_EMAIL=<acme-account-email>      # non-empty = facility ON
# gen-certs.sh (make certs / every make up) then runs certbot (HTTP-01,
# standalone, binds port 80 only while validating) and installs the result as
# certs/server.{crt,key}; nginx and the CSP are untouched.
# Requirements:
#   * EVERY listed SAN hostname must resolve DIRECTLY to this box with no CDN
#     proxy / Always-HTTPS redirect in front (HTTP-01 validates over plain
#     port 80). A proxied hostname — e.g. webvm.nedprod.com behind Cloudflare
#     — must NOT be listed here.
#   * certbot must be installed on the HOST: apt-get install -y certbot
#     (Ubuntu/Debian; its certbot.timer then renews twice daily; the deploy
#     hook scripts/le-install.sh swaps the cert into certs/ and reloads nginx
#     automatically).
#   * NOT for tailnet/LAN deployments (samba/webdav backends or
#     HEADSCALE_ENABLED=1): gen-certs.sh fails closed — the public cert has no
#     IP SANs for the gateway's 172.28.0.10 control-plane dial.
# LETSENCRYPT_DOMAINS empty = the SAN is derived from the DNS names the
# private cert would carry (a hostname CONTROL_HOST + the WEBVM_DISK_BASE_URL
# host). Set it to an explicit comma/space-separated list to override (on
# webvm.nedprod.com the main site is CF-proxied, so the disk host only:
# LETSENCRYPT_DOMAINS=disk.webvm.nedprod.com).
LETSENCRYPT_EMAIL=
LETSENCRYPT_DOMAINS=

# WebDAV backend (used when STORAGE_BACKEND=webdav)
WEBDAV_ROOT=/data/webdav
DATA_DIR=./data
# These are the wsgidav server credentials AND the guest's baked sync
# credentials: build.sh falls back SYNC_USER/SYNC_PASS to them when rendering
# /root/.syncrc, so the baked fallback always matches the server.
WEBDAV_USER=
WEBDAV_PASS=

# Samba backend (used when STORAGE_BACKEND=samba)
# SAMBA_LAN_IP is the existing Samba server's LAN IP (routed through the
# gateway relay); the guest always talks to the gateway tailnet IP instead.
SAMBA_LAN_IP=
SAMBA_SHARE=
SAMBA_USER=
SAMBA_PASS=

# --- Tailnet (used when STORAGE_BACKEND=samba|webdav, or HEADSCALE_ENABLED=1) ---
# Created once (the pinned headscale 0.29.x takes the NUMERIC user id — the
# first user is 1; `headscale users list` shows the id). BOTH keys are
# reusable + long-lived so recreated containers and saved session URLs keep
# working. The BROWSER key (HEADSCALE_PREAUTHKEY) is created with --ephemeral
# so closed tabs stop accumulating stale nodes (headscale reaps a disconnected
# ephemeral node after node.ephemeral.inactivity_timeout, default 30m);
# the GATEWAY key (GATEWAY_AUTHKEY) is persistent — it holds the gateway's
# node record and therefore its allocated tailnet IP, which must stay stable:
#   HEADSCALE_BOOTSTRAP=1 docker compose up -d server
#   docker compose exec server headscale preauthkeys create --user 1 --reusable --ephemeral --expiration 100y
#   docker compose exec server headscale preauthkeys create --user 1 --reusable --expiration 100y
# Record the two printed values below (first = HEADSCALE_PREAUTHKEY, second =
# GATEWAY_AUTHKEY). In tailnet modes these are baked into the served page
# (/webvm-config.js) at container start — visiting the site root needs no hash
# URL; anyone who can reach the site can read the preauth key (the same LAN
# trust boundary as the served ext2). Key rotation: edit .env and
# `docker compose up -d server`.
# IMPORTANT: keep HEADSCALE_BOOTSTRAP=1 until GATEWAY_TAILNET_IP below is
# recorded (first `docker compose up -d` with BOOTSTRAP=1, then
# `docker compose exec server headscale nodes list` and take the gateway's
# IP). With BOOTSTRAP=0 and no IP the entrypoint fails closed and the server
# crash-loops.
HEADSCALE_PREAUTHKEY=
GATEWAY_AUTHKEY=

# Actual tailnet IP assigned to the gateway on its first join
# (`headscale nodes list` / `tailscale status`); NOT a pre-reserved default.
# REQUIRED before setting HEADSCALE_BOOTSTRAP=0 (fail-closed check).
GATEWAY_TAILNET_IP=

# Git relays (host-side step: set, then `docker compose --profile tailnet up -d`
# to recreate the gateway and add the relay; the guest then adds remotes like
# `ssh://git@<GATEWAY_TAILNET_IP>:2222/<path>`). The SSH relay port comes from
# the shared lib (GIT_SSH_PORT, default 2222) and IS forwarded to the gateway
# container (compose.yaml), so an override here remaps the relay; the guest
# remote must use the same value.
GIT_SSH_LAN_IP=
GIT_SSH_PORT=2222
GIT_HTTP_LAN_IP=
GIT_HTTP_PORT=8083

# Force the headscale control plane on even for browser/none builds
# (Phase 2 validation).
HEADSCALE_ENABLED=0

# --- Periodic storage reset countdown (OPTIONAL, opt-in) ---
# A public instance can reset itself on a fixed cadence: every
# RESET_INTERVAL_HOURS the webdav storage is wiped and the stack restored.
# scripts/reset-cycle.sh (the host cron entry) also pulls + rebuilds the
# deployment when the git upstream has new commits. The service is stopped
# and started ONLY when there is something to do: the backend has server-side
# storage to reset (webdav, requires RESET_INTERVAL_HOURS) or an upstream
# pull + rebuild happened — a browser/none/samba backend with no upstream
# changes leaves the running stack untouched. The sidebar then
# shows end users a live "storage resets in HH:MM:SS" countdown. Leave this
# unset/empty (default) for the facility to be OFF (the update/rebuild leg of
# the cycle still works without it — a browser-backend cron needs no
# countdown and no storage wipe).
# To enable: set the period here, then run scripts/reset-cycle.sh once and
# install it on a host cron, e.g.:
#   0 2,8,14,20 * * * cd /path/to/deployment && ./scripts/reset-cycle.sh >> /var/log/webvm-reset.log 2>&1
# The next deadline (epoch seconds) is stored in state/reset/deadline
# (RESET_STATE_DIR, gitignored, bind-mounted into the server container at
# /etc/webvm/reset) and baked into /webvm-config.js at each container start.
RESET_INTERVAL_HOURS=

# --- Deployment-scoped docker prune (OPTIONAL, opt-in) ---
# After a reset-cycle that actually rebuilt/restarted the stack, run
# `docker system prune -af` to reclaim the build-cache + layer churn a
# tight-disk VPS accumulates on every rebuild. Set to 1 in THIS DEPLOYMENT's
# .env only (never a shared default); state volumes are never pruned.
PRUNE_DOCKER=0
