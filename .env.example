# WebVM custom deployment overrides.
# This file is optional: everything has an inline default in compose.yaml.
# Copy to `.env` and edit. NEVER commit `.env`.

# --- Access / networking ---
# Single machine: keep the defaults — CONTROL_HOST=127.0.0.1 (zero-config,
# NO /etc/hosts entries, NO hostnames of any kind). LAN/multi-device use:
# set both CONTROL_HOST and LAN_IP to the hardcoded LAN address, e.g.
# 192.168.1.10. HOSTNAMES ARE BANNED (host.docker.internal and /etc/hosts
# tricks must never be reintroduced): the browser reaches the control plane
# over 127.0.0.1 / a LAN IP alone.
# Ports are published ONLY on LAN_IP — never on all interfaces.
CONTROL_HOST=127.0.0.1
LAN_IP=127.0.0.1

# Ports (defaults; arbitrary remapping supported — see the plan §10.9)
SITE_PORT=8081
CONTROL_PORT=8443
WEBDAV_PORT=8082
STUN_PORT=3478

# --- Storage backend (browser | samba | webdav | none) ---
STORAGE_BACKEND=browser

# WebDAV backend (used when STORAGE_BACKEND=webdav)
WEBDAV_ROOT=/data/webdav
DATA_DIR=./data
# These are the wsgidav server credentials AND the guest's baked sync
# credentials: build.sh falls back SYNC_USER/SYNC_PASS to them when rendering
# /root/.syncrc, so the baked fallback always matches the server.
WEBDAV_USER=
WEBDAV_PASS=

# Samba backend (used when STORAGE_BACKEND=samba)
# SAMBA_LAN_IP is the existing Samba server's LAN IP (routed through the
# gateway relay); the guest always talks to the gateway tailnet IP instead.
SAMBA_LAN_IP=
SAMBA_SHARE=
SAMBA_USER=
SAMBA_PASS=

# --- Tailnet (used when STORAGE_BACKEND=samba|webdav, or HEADSCALE_ENABLED=1) ---
# Created once (the pinned headscale 0.28.x takes the NUMERIC user id — the
# first user is 1; `headscale users list` shows the id). BOTH keys are
# reusable + long-lived so recreated containers and saved session URLs keep
# working. The BROWSER key (HEADSCALE_PREAUTHKEY) is created with --ephemeral
# so closed tabs stop accumulating stale nodes (headscale reaps a disconnected
# ephemeral node after node.ephemeral_node_inactivity_timeout, default 30m);
# the GATEWAY key (GATEWAY_AUTHKEY) is persistent — it holds the gateway's
# node record and therefore its allocated tailnet IP, which must stay stable:
#   HEADSCALE_BOOTSTRAP=1 docker compose up -d server
#   docker compose exec server headscale preauthkeys create --user 1 --reusable --ephemeral --expiration 100y
#   docker compose exec server headscale preauthkeys create --user 1 --reusable --expiration 100y
# Record the two printed values below (first = HEADSCALE_PREAUTHKEY, second =
# GATEWAY_AUTHKEY). In tailnet modes these are baked into the served page
# (/webvm-config.js) at container start — visiting the site root needs no hash
# URL; anyone who can reach the site can read the preauth key (the same LAN
# trust boundary as the served ext2). Key rotation: edit .env and
# `docker compose up -d server`.
# IMPORTANT: keep HEADSCALE_BOOTSTRAP=1 until GATEWAY_TAILNET_IP below is
# recorded (first `docker compose up -d` with BOOTSTRAP=1, then
# `docker compose exec server headscale nodes list` and take the gateway's
# IP). With BOOTSTRAP=0 and no IP the entrypoint fails closed and the server
# crash-loops.
HEADSCALE_PREAUTHKEY=
GATEWAY_AUTHKEY=

# Actual tailnet IP assigned to the gateway on its first join
# (`headscale nodes list` / `tailscale status`); NOT a pre-reserved default.
# REQUIRED before setting HEADSCALE_BOOTSTRAP=0 (fail-closed check).
GATEWAY_TAILNET_IP=

# Git relays (host-side step: set, then `docker compose --profile tailnet up -d`
# to recreate the gateway and add the relay; the guest then adds remotes like
# `ssh://git@<GATEWAY_TAILNET_IP>:2222/<path>`).
GIT_SSH_LAN_IP=
GIT_HTTP_LAN_IP=
GIT_HTTP_PORT=8083

# Force the headscale control plane on even for browser/none builds
# (Phase 2 validation).
HEADSCALE_ENABLED=0
