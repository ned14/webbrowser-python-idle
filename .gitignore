# Secrets and local overrides — never commit these
# `.env*` (not just `.env`): backups/copies of the local env carry the same
# live credentials (observed 2026-09-02: an unignored `.env.webdav-backup`
# holding real HEADSCALE/GATEWAY/WEBDAV secrets nearly got staged).
.env*

# Generated private CA and certificates
certs/
# openssl -CAcreateserial side effect (sometimes left in the repo root)
.srl

# WebDAV data directory
data/

# Reset-cycle state (next-reset deadline written by scripts/reset-cycle.sh)
state/

# Guest artifacts baked with real credentials / keys
diskimage/rootfs/home/user/.ssh/
diskimage/rootfs/root/.syncrc

# Build outputs
*.ext2
*.tar.gz
rootfs.tar
webvm/build/
webvm/node_modules/
webvm/custom-disk-images/
webvm/.svelte-kit/

# Python bytecode
__pycache__/
*.pyc

# Test artifacts
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/node_modules/

# Editor / OS cruft
.DS_Store
*.swp
