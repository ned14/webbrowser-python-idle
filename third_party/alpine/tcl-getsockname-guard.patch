--- a/unix/tclUnixChan.c	2021-10-29 18:08:08
+++ b/unix/tclUnixChan.c	2026-08-12 23:00:58
@@ -13,6 +13,7 @@
 
 #include "tclInt.h"	/* Internal definitions for Tcl. */
 #include "tclIO.h"	/* To get Channel type declaration. */
+#include <sys/stat.h>	/* S_ISSOCK for the getsockname guard. */
 
 #undef SUPPORTS_TTY
 #if defined(HAVE_TERMIOS_H)
@@ -1534,11 +1535,21 @@
 	sprintf(channelName, "serial%d", fd);
     } else
 #endif /* SUPPORTS_TTY */
-    if ((getsockname(fd, (struct sockaddr *)&sockaddr, &sockaddrLen) == 0)
-	&& (sockaddrLen > 0)
-	&& (sockaddr.sa_family == AF_INET || sockaddr.sa_family == AF_INET6)) {
-	return TclpMakeTcpClientChannelMode(INT2PTR(fd), mode);
-    } else {
+    /*
+     * Only probe with getsockname() when fstat() says this fd is actually a
+     * socket. On a correct system getsockname() on a non-socket fd returns
+     * ENOTSOCK quickly, but CheerpX's virtual getsockname() hangs forever on
+     * non-socket fds (plans/display-bug.md §2.2), which froze Tcl's standard
+     * channel setup and IDLE's startup.
+     */
+    {
+	struct stat st;
+	if ((fstat(fd, &st) == 0) && S_ISSOCK(st.st_mode)
+		&& (getsockname(fd, (struct sockaddr *)&sockaddr, &sockaddrLen) == 0)
+		&& (sockaddrLen > 0)
+		&& (sockaddr.sa_family == AF_INET || sockaddr.sa_family == AF_INET6)) {
+	    return TclpMakeTcpClientChannelMode(INT2PTR(fd), mode);
+	}
 	channelTypePtr = &fileChannelType;
 	sprintf(channelName, "file%d", fd);
     }
