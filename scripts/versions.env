# Version pins that must stay in lockstep across the gateway image, the
# join-test client and the tailscale-wasm rebuild (tests/unit/test_scripts.py
# enforces the lockstep). Bump here first, then update the consumers.
TAILSCALE_VERSION=1.102.2
GO_VERSION=1.26.6
# The self-hosted CheerpX runtime (webvm/cheerpx/ — fetched by
# scripts/fetch-cheerpx-runtime.sh; the frontend pin lives in webvm/
# package.json + src/lib/cheerpx.js, both enforced against THIS value by
# tests/unit/test_scripts.py).
CHEERPX_VERSION=1.3.8
